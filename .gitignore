/target
**/*.rs.bk
Cargo.lock.orig
.DS_Store
.codegraph/

# graphify AST cache: derived build artifact, never source
graphify-out/

# The benchmark rig is its own Cargo workspace, so a default `cargo run` there
# creates a target directory the root `/target` rule does not cover.
bench/target/

# HOL4 theory output: compiled objects and the signature store are derived build
# artifacts. The proof script is the source and is committed; these are not.
proofs/sigobj/
proofs/*.uo
proofs/*.ui
proofs/*.uo.tmp
proofs/.hol/

# Python bytecode from the repository's own check scripts. `scripts/` holds
# committed, runnable tools; importing one — which is how a checker's helpers
# get exercised while it is being written — leaves a cache beside it.
__pycache__/

# local gate receipts: derived from a run, not tree content
evidence/
